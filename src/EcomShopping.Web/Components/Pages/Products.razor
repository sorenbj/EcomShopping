@page "/products"
@using EcomShopping.Application.DTOs
@using EcomShopping.Web.Services
@inject ProductApiService ProductApi
@inject NavigationManager NavigationManager
@inject ILogger<Products> Logger
@rendermode InteractiveServer

<PageTitle>Products - EcomShopping</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="mb-3">Products</h1>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <!-- Filter Section -->
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Filters</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="searchInput" class="form-label">Search</label>
                        <input type="text" class="form-control" id="searchInput" 
                               @bind="searchTerm" @bind:event="oninput"
                               placeholder="Search products..." />
                    </div>

                    @if (categories != null && categories.Any())
                    {
                        <div class="mb-3">
                            <label for="categorySelect" class="form-label">Category</label>
                            <select class="form-select" id="categorySelect" @bind="selectedCategoryId">
                                <option value="">All Categories</option>
                                @foreach (var category in categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="mb-3">
                        <label for="sortSelect" class="form-label">Sort By</label>
                        <select class="form-select" id="sortSelect" @bind="sortBy">
                            <option value="">Default</option>
                            <option value="name">Name (A-Z)</option>
                            <option value="name-desc">Name (Z-A)</option>
                            <option value="price">Price (Low to High)</option>
                            <option value="price-desc">Price (High to Low)</option>
                        </select>
                    </div>

                    <button class="btn btn-primary w-100" @onclick="ApplyFilters">
                        Apply Filters
                    </button>
                    <button class="btn btn-outline-secondary w-100 mt-2" @onclick="ClearFilters">
                        Clear Filters
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            @if (loading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading products...</p>
                </div>
            }
            else if (errorMessage != null)
            {
                <div class="alert alert-danger" role="alert">
                    <h4 class="alert-heading">Error</h4>
                    <p>@errorMessage</p>
                    <button class="btn btn-primary" @onclick="LoadProducts">Try Again</button>
                </div>
            }
            else if (products == null || !products.Any())
            {
                <div class="alert alert-info" role="alert">
                    <h4 class="alert-heading">No Products Found</h4>
                    <p>No products match your current filters. Try adjusting your search criteria.</p>
                </div>
            }
            else
            {
                <!-- Products Grid -->
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
                    @foreach (var product in products)
                    {
                        <div class="col">
                            <div class="card h-100 product-card">
                                @if (product.Images?.Any() == true)
                                {
                                    <img src="@product.Images.First()" class="card-img-top product-image" alt="@product.Name">
                                }
                                else
                                {
                                    <div class="card-img-top bg-light d-flex align-items-center justify-content-center product-image">
                                        <span class="text-muted">No Image</span>
                                    </div>
                                }
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">@product.Name</h5>
                                    @if (!string.IsNullOrWhiteSpace(product.CategoryName))
                                    {
                                        <p class="card-text text-muted small mb-2">@product.CategoryName</p>
                                    }
                                    <p class="card-text flex-grow-1">
                                        @if (product.Description?.Length > 100)
                                        {
                                            @product.Description.Substring(0, 100)@("...")
                                        }
                                        else
                                        {
                                            @product.Description
                                        }
                                    </p>
                                    <div class="d-flex justify-content-between align-items-center mt-auto">
                                        <h4 class="mb-0 text-primary">@product.Price.ToString("C")</h4>
                                        @if (product.StockQuantity > 0)
                                        {
                                            <span class="badge bg-success">In Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Out of Stock</span>
                                        }
                                    </div>
                                    <a href="/products/@product.Id" class="btn btn-primary mt-3">
                                        View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <nav aria-label="Product pagination">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage - 1)" disabled="@(currentPage <= 1)">
                                    Previous
                                </button>
                            </li>

                            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                            {
                                var pageNum = i;
                                <li class="page-item @(currentPage == pageNum ? "active" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(pageNum)">
                                        @pageNum
                                    </button>
                                </li>
                            }

                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage + 1)" disabled="@(currentPage >= totalPages)">
                                    Next
                                </button>
                            </li>
                        </ul>
                    </nav>

                    <p class="text-center text-muted">
                        Showing @((currentPage - 1) * pageSize + 1) - @Math.Min(currentPage * pageSize, totalCount) of @totalCount products
                    </p>
                }
            }
        </div>
    </div>
</div>

<style>
    .product-card {
        transition: transform 0.2s, box-shadow 0.2s;
        cursor: pointer;
    }

    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    .product-image {
        height: 200px;
        object-fit: cover;
    }
</style>

@code {
    private List<ProductDto>? products;
    private List<CategoryDto>? categories;
    private bool loading = true;
    private string? errorMessage;

    private string searchTerm = "";
    private string? selectedCategoryId = "";
    private string sortBy = "";
    
    private int currentPage = 1;
    private int pageSize = 12;
    private int totalCount = 0;
    private int totalPages = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
        await LoadProducts();
    }

    private async Task LoadCategories()
    {
        try
        {
            categories = await ProductApi.GetCategoriesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading categories");
        }
    }

    private async Task LoadProducts()
    {
        loading = true;
        errorMessage = null;

        try
        {
            int? categoryId = null;
            if (!string.IsNullOrWhiteSpace(selectedCategoryId) && int.TryParse(selectedCategoryId, out var catId))
            {
                categoryId = catId;
            }

            string? sortField = null;
            bool sortDescending = false;

            if (!string.IsNullOrWhiteSpace(sortBy))
            {
                if (sortBy.EndsWith("-desc"))
                {
                    sortField = sortBy.Replace("-desc", "");
                    sortDescending = true;
                }
                else
                {
                    sortField = sortBy;
                }
            }

            var response = await ProductApi.GetProductsAsync(
                currentPage, 
                pageSize, 
                string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
                categoryId,
                sortField,
                sortDescending
            );

            if (response != null)
            {
                products = response.Items;
                totalCount = response.TotalCount;
                totalPages = response.TotalPages;
            }
            else
            {
                errorMessage = "Unable to load products. Please ensure the API is running.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading products: {ex.Message}";
            Logger.LogError(ex, "Error loading products");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadProducts();
    }

    private async Task ClearFilters()
    {
        searchTerm = "";
        selectedCategoryId = "";
        sortBy = "";
        currentPage = 1;
        await LoadProducts();
    }

    private async Task GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            await LoadProducts();
        }
    }
}
