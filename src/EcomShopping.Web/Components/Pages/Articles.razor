@page "/articles"
@using EcomShopping.Application.DTOs
@using EcomShopping.Web.Services
@inject ArticleApiService ArticleApi
@inject NavigationManager NavigationManager
@inject ILogger<Articles> Logger
@rendermode InteractiveServer

<PageTitle>Articles - EcomShopping</PageTitle>

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="mb-3">Articles</h1>
            <p class="lead text-muted">Explore our latest articles and blog posts</p>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading articles...</p>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading">Error</h4>
            <p>@errorMessage</p>
            <button class="btn btn-primary" @onclick="LoadArticles">Try Again</button>
        </div>
    }
    else if (articles == null || !articles.Any())
    {
        <div class="alert alert-info" role="alert">
            <h4 class="alert-heading">No Articles Found</h4>
            <p>There are no published articles at the moment. Please check back later!</p>
        </div>
    }
    else
    {
        <!-- Articles Grid -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
            @foreach (var article in articles)
            {
                <div class="col">
                    <div class="card h-100 article-card">
                        @if (!string.IsNullOrWhiteSpace(article.ImageUrl))
                        {
                            <img src="@article.ImageUrl" class="card-img-top article-image" alt="@article.Title">
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center article-image">
                                <span class="text-muted">No Image</span>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@article.Title</h5>
                            @if (!string.IsNullOrWhiteSpace(article.Author))
                            {
                                <p class="card-text text-muted small mb-2">By @article.Author</p>
                            }
                            @if (article.PublishedAt.HasValue)
                            {
                                <p class="card-text text-muted small mb-2">
                                    @article.PublishedAt.Value.ToLocalTime().ToString("MMMM dd, yyyy")
                                </p>
                            }
                            <p class="card-text flex-grow-1">
                                @if (!string.IsNullOrWhiteSpace(article.Summary))
                                {
                                    @if (article.Summary.Length > 150)
                                    {
                                        @article.Summary.Substring(0, 150)@("...")
                                    }
                                    else
                                    {
                                        @article.Summary
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">No summary available</span>
                                }
                            </p>
                            <a href="/articles/@article.Slug" class="btn btn-primary mt-3">
                                Read More
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <nav aria-label="Article pagination">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(currentPage - 1)" disabled="@(currentPage <= 1)">
                            Previous
                        </button>
                    </li>

                    @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                    {
                        var pageNum = i;
                        <li class="page-item @(currentPage == pageNum ? "active" : "")">
                            <button class="page-link" @onclick="() => GoToPage(pageNum)">
                                @pageNum
                            </button>
                        </li>
                    }

                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(currentPage + 1)" disabled="@(currentPage >= totalPages)">
                            Next
                        </button>
                    </li>
                </ul>
            </nav>

            <p class="text-center text-muted">
                Showing @((currentPage - 1) * pageSize + 1) - @Math.Min(currentPage * pageSize, totalCount) of @totalCount articles
            </p>
        }
    }
</div>

<style>
    .article-card {
        transition: transform 0.2s, box-shadow 0.2s;
        cursor: pointer;
    }

    .article-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    .article-image {
        height: 200px;
        object-fit: cover;
    }
</style>

@code {
    private List<ArticleDto>? articles;
    private bool loading = true;
    private string? errorMessage;
    
    private int currentPage = 1;
    private int pageSize = 9;
    private int totalCount = 0;
    private int totalPages = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadArticles();
    }

    private async Task LoadArticles()
    {
        loading = true;
        errorMessage = null;

        try
        {
            var response = await ArticleApi.GetArticlesAsync(currentPage, pageSize);

            if (response != null)
            {
                articles = response.Items;
                totalCount = response.TotalCount;
                totalPages = response.TotalPages;
            }
            else
            {
                errorMessage = "Unable to load articles. Please ensure the API is running.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading articles: {ex.Message}";
            Logger.LogError(ex, "Error loading articles");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            await LoadArticles();
        }
    }
}
