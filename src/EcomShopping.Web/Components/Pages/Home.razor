@page "/"

<PageTitle>Home - EcomShopping</PageTitle>

<div class="container py-5">
    <div class="row">
        <div class="col-md-12 text-center mb-5">
            <h1 class="display-4">Welcome to EcomShopping</h1>
            <p class="lead">Your one-stop shop for all your needs</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card text-center">
                <div class="card-body p-5">
                    <h2 class="card-title mb-4">Browse Our Products</h2>
                    <p class="card-text mb-4">
                        Discover our wide range of products with advanced filtering and sorting options.
                    </p>
                    <a href="/products" class="btn btn-primary btn-lg">
                        View Products
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">🛍️ Wide Selection</h5>
                    <p class="card-text">Browse through our extensive catalog of products.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">🔍 Easy Search</h5>
                    <p class="card-text">Find exactly what you're looking for with our search and filter features.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">💰 Best Prices</h5>
                    <p class="card-text">Get the best deals on quality products.</p>
                </div>
            </div>
        </div>
    </div>
</div>

