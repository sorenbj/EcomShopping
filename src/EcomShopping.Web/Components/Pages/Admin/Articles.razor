@page "/admin/articles"
@rendermode InteractiveServer
@inject ArticleApiService ArticleApi
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Article Management - EcomShopping</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1 class="display-6">Article Management</h1>
        </div>
        <div class="col-md-6 text-end">
            <a href="/admin/articles/create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add New Article
            </a>
            <a href="/admin" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Filter Options -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <select class="form-select" @bind="filterStatus" @bind:after="LoadArticlesAsync">
                        <option value="all">All Articles</option>
                        <option value="published">Published Only</option>
                        <option value="draft">Drafts Only</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select" @bind="pageSize" @bind:after="LoadArticlesAsync">
                        <option value="10">10 per page</option>
                        <option value="25">25 per page</option>
                        <option value="50">50 per page</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (articlesResponse != null && articlesResponse.Items.Any())
    {
        <!-- Articles Table -->
        <div class="card">
            <div class="card-header">
                <strong>@articlesResponse.TotalCount Articles</strong> 
                (Page @currentPage of @articlesResponse.TotalPages)
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Published</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var article in filteredArticles)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(article.ImageUrl))
                                    {
                                        <img src="@article.ImageUrl" alt="@article.Title" 
                                             style="width: 50px; height: 50px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center" 
                                             style="width: 50px; height: 50px;">
                                            <i class="bi bi-newspaper"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <strong>@article.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(article.Summary))
                                    {
                                        <br />
                                        <small class="text-muted">
                                            @(article.Summary.Length > 60 ? article.Summary.Substring(0, 60) + "..." : article.Summary)
                                        </small>
                                    }
                                </td>
                                <td>@(article.Author ?? "Unknown")</td>
                                <td>
                                    @if (article.IsPublished)
                                    {
                                        <span class="badge bg-success">Published</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Draft</span>
                                    }
                                </td>
                                <td>
                                    <small class="text-muted">
                                        @article.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                                    </small>
                                </td>
                                <td>
                                    @if (article.PublishedAt.HasValue)
                                    {
                                        <small class="text-muted">
                                            @article.PublishedAt.Value.ToLocalTime().ToString("MMM dd, yyyy")
                                        </small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">-</small>
                                    }
                                </td>
                                <td>
                                    <a href="/admin/articles/edit/@article.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (article.IsPublished)
                                    {
                                        <a href="/articles/@article.Slug" class="btn btn-sm btn-outline-info" target="_blank">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteArticle(article.Id)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="card-footer">
                <nav aria-label="Article pagination">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">Previous</button>
                        </li>
                        
                        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(articlesResponse.TotalPages, currentPage + 2); i++)
                        {
                            var pageNumber = i;
                            <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                <button class="page-link" @onclick="() => ChangePage(pageNumber)">@pageNumber</button>
                            </li>
                        }
                        
                        <li class="page-item @(currentPage >= articlesResponse.TotalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Next</button>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            No articles found. <a href="/admin/articles/create" class="alert-link">Create your first article</a>
        </div>
    }
</div>

@code {
    private PagedArticleResponse? articlesResponse;
    private bool isLoading = true;
    private int currentPage = 1;
    private int pageSize = 25;
    private string filterStatus = "all";

    protected override async Task OnInitializedAsync()
    {
        await LoadArticlesAsync();
    }

    private List<ArticleDto> filteredArticles
    {
        get
        {
            if (articlesResponse == null || !articlesResponse.Items.Any())
                return new List<ArticleDto>();

            return filterStatus switch
            {
                "published" => articlesResponse.Items.Where(a => a.IsPublished).ToList(),
                "draft" => articlesResponse.Items.Where(a => !a.IsPublished).ToList(),
                _ => articlesResponse.Items.ToList()
            };
        }
    }

    private async Task LoadArticlesAsync()
    {
        isLoading = true;
        articlesResponse = await ArticleApi.GetAllArticlesAsync(
            page: currentPage,
            pageSize: pageSize
        );
        isLoading = false;
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || (articlesResponse != null && page > articlesResponse.TotalPages))
            return;

        currentPage = page;
        await LoadArticlesAsync();
    }

    private async Task DeleteArticle(int id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this article?"))
        {
            var success = await ArticleApi.DeleteArticleAsync(id);
            if (success)
            {
                await LoadArticlesAsync();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Failed to delete article. Please try again.");
            }
        }
    }
}
