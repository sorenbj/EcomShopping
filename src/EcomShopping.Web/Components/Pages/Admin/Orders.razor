@page "/admin/orders"
@rendermode InteractiveServer
@inject OrdersApiService OrdersApi
@inject NavigationManager Navigation

<PageTitle>Order Management - EcomShopping</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1 class="display-6">Order Management</h1>
        </div>
        <div class="col-md-6 text-end">
            <a href="/admin" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Order Number</label>
                    <input type="text" class="form-control" @bind="orderNumber" placeholder="Search by order #" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <select class="form-select" @bind="selectedStatus">
                        <option value="">All Statuses</option>
                        <option value="Pending">Pending</option>
                        <option value="Processing">Processing</option>
                        <option value="Shipped">Shipped</option>
                        <option value="Delivered">Delivered</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Start Date</label>
                    <input type="date" class="form-control" @bind="startDate" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">End Date</label>
                    <input type="date" class="form-control" @bind="endDate" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100" @onclick="SearchOrders">
                        <i class="bi bi-search"></i> Search
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else if (ordersResponse != null && ordersResponse.Items.Any())
    {
        <!-- Orders Table -->
        <div class="card">
            <div class="card-header">
                <strong>@ordersResponse.TotalCount Orders</strong>
                (Page @currentPage of @ordersResponse.TotalPages)
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Payment</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in ordersResponse.Items)
                        {
                            <tr>
                                <td><strong>@order.OrderNumber</strong></td>
                                <td><small>@order.OrderDate.ToString("g")</small></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(order.UserId))
                                    {
                                        <small>User: @order.UserId</small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">Guest</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@order.Items.Count</span>
                                </td>
                                <td><strong>$@order.TotalAmount.ToString("N2")</strong></td>
                                <td>
                                    <select class="form-select form-select-sm" 
                                            @onchange="e => UpdateOrderStatus(order.Id, e.Value?.ToString() ?? string.Empty)"
                                            value="@order.Status.ToString()">
                                        <option value="Pending" selected="@(order.Status.ToString() == "Pending")">Pending</option>
                                        <option value="Processing" selected="@(order.Status.ToString() == "Processing")">Processing</option>
                                        <option value="Shipped" selected="@(order.Status.ToString() == "Shipped")">Shipped</option>
                                        <option value="Delivered" selected="@(order.Status.ToString() == "Delivered")">Delivered</option>
                                        <option value="Cancelled" selected="@(order.Status.ToString() == "Cancelled")">Cancelled</option>
                                    </select>
                                </td>
                                <td>
                                    @if (order.PaymentStatus.ToString() == "Completed")
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else if (order.PaymentStatus.ToString() == "Pending")
                                    {
                                        <span class="badge bg-warning">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@order.PaymentStatus</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" 
                                            @onclick="() => ViewOrderDetails(order.Id)">
                                        <i class="bi bi-eye"></i> View
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="card-footer">
                <nav aria-label="Order pagination">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">Previous</button>
                        </li>

                        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(ordersResponse.TotalPages, currentPage + 2); i++)
                        {
                            var pageNumber = i;
                            <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                <button class="page-link" @onclick="() => ChangePage(pageNumber)">@pageNumber</button>
                            </li>
                        }

                        <li class="page-item @(currentPage >= ordersResponse.TotalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Next</button>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">No orders found matching your criteria.</div>
    }
</div>

@code {
    private PagedOrderResponse? ordersResponse;
    private bool isLoading = true;
    private string orderNumber = string.Empty;
    private string selectedStatus = string.Empty;
    private DateTime? startDate;
    private DateTime? endDate;
    private int currentPage = 1;
    private int pageSize = 20;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrdersAsync();
    }

    private async Task LoadOrdersAsync()
    {
        isLoading = true;

        OrderStatus? status = null;
        if (!string.IsNullOrEmpty(selectedStatus) && Enum.TryParse<OrderStatus>(selectedStatus, out var parsedStatus))
        {
            status = parsedStatus;
        }

        ordersResponse = await OrdersApi.GetOrdersAsync(
            userId: null,
            status: status,
            startDate: startDate,
            endDate: endDate,
            orderNumber: string.IsNullOrWhiteSpace(orderNumber) ? null : orderNumber,
            page: currentPage,
            pageSize: pageSize
        );

        isLoading = false;
    }

    private async Task SearchOrders()
    {
        currentPage = 1;
        await LoadOrdersAsync();
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || (ordersResponse != null && page > ordersResponse.TotalPages))
            return;

        currentPage = page;
        await LoadOrdersAsync();
    }

    private async Task UpdateOrderStatus(int orderId, string statusString)
    {
        if (Enum.TryParse<OrderStatus>(statusString, out var newStatus))
        {
            var success = await OrdersApi.UpdateOrderStatusAsync(orderId, newStatus);
            if (success)
            {
                await LoadOrdersAsync();
            }
        }
    }

    private void ViewOrderDetails(int orderId)
    {
        Navigation.NavigateTo($"/admin/orders/{orderId}");
    }
}
