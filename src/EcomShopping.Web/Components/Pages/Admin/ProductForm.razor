@page "/admin/products/create"
@page "/admin/products/edit/{Id:int}"
@rendermode InteractiveServer
@inject ProductApiService ProductApi
@inject CategoriesApiService CategoriesApi
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>@(isEditMode ? "Edit Product" : "Create Product") - EcomShopping</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1 class="display-6">@(isEditMode ? "Edit Product" : "Create New Product")</h1>
        </div>
        <div class="col-md-6 text-end">
            <a href="/admin/products" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to Products
            </a>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Product Information</h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                @errorMessage
                                <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                            </div>
                        }

                        <EditForm Model="@product" OnValidSubmit="HandleSubmit">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger" />

                            <div class="mb-3">
                                <label class="form-label">Product Name *</label>
                                <InputText class="form-control" @bind-Value="product.Name" placeholder="Enter product name" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">SKU *</label>
                                <InputText class="form-control" @bind-Value="product.SKU" placeholder="Enter SKU" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <InputTextArea class="form-control" @bind-Value="product.Description" rows="4" placeholder="Enter product description" />
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Price *</label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <InputNumber class="form-control" @bind-Value="product.Price" placeholder="0.00" />
                                    </div>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Stock Quantity *</label>
                                    <InputNumber class="form-control" @bind-Value="product.StockQuantity" placeholder="0" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Category</label>
                                <InputSelect class="form-select" @bind-Value="product.CategoryId">
                                    <option value="">-- Select Category --</option>
                                    @foreach (var category in categories)
                                    {
                                        <option value="@category.Id">@category.Name</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="mb-3">
                                <div class="form-check form-switch">
                                    <InputCheckbox class="form-check-input" @bind-Value="product.IsActive" />
                                    <label class="form-check-label">Active (visible to customers)</label>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Product Images (URLs)</label>
                                <small class="form-text text-muted d-block mb-2">
                                    Add image URLs (one per line). First image will be the primary image.
                                </small>
                                <textarea class="form-control" @bind="imagesText" rows="4" 
                                          placeholder="https://example.com/image1.jpg&#10;https://example.com/image2.jpg"></textarea>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                    @if (isSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    }
                                    <i class="bi bi-save"></i> @(isEditMode ? "Update Product" : "Create Product")
                                </button>
                                <a href="/admin/products" class="btn btn-outline-secondary">Cancel</a>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Preview</h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrWhiteSpace(product.Name))
                        {
                            <h6>@product.Name</h6>
                        }
                        else
                        {
                            <h6 class="text-muted">Product Name</h6>
                        }

                        @if (!string.IsNullOrWhiteSpace(product.SKU))
                        {
                            <p class="text-muted mb-2"><small>SKU: @product.SKU</small></p>
                        }

                        @if (product.Price > 0)
                        {
                            <h4 class="text-primary">$@product.Price.ToString("N2")</h4>
                        }

                        @if (!string.IsNullOrWhiteSpace(product.Description))
                        {
                            <p class="mt-3"><small>@product.Description</small></p>
                        }

                        @if (product.CategoryId.HasValue && categories.Any())
                        {
                            var selectedCategory = categories.FirstOrDefault(c => c.Id == product.CategoryId.Value);
                            if (selectedCategory != null)
                            {
                                <p class="mb-2"><small><strong>Category:</strong> @selectedCategory.Name</small></p>
                            }
                        }

                        <p class="mb-2"><small><strong>Stock:</strong> @product.StockQuantity units</small></p>
                        <p class="mb-0">
                            <small>
                                <strong>Status:</strong>
                                @if (product.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </small>
                        </p>
                    </div>
                </div>

                @if (ParseImages().Any())
                {
                    <div class="card mt-3">
                        <div class="card-header">
                            <h6 class="mb-0">Images (@ParseImages().Count)</h6>
                        </div>
                        <div class="card-body">
                            @foreach (var imageUrl in ParseImages())
                            {
                                <img src="@imageUrl" alt="Product" class="img-fluid mb-2" style="max-height: 150px;" />
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private ProductFormModel product = new();
    private List<Category> categories = new();
    private bool isEditMode = false;
    private bool isLoading = true;
    private bool isSaving = false;
    private string errorMessage = string.Empty;
    private string imagesText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAsync();

        if (Id.HasValue)
        {
            isEditMode = true;
            await LoadProductAsync(Id.Value);
        }

        isLoading = false;
    }

    private async Task LoadCategoriesAsync()
    {
        var categoriesData = await CategoriesApi.GetCategoriesAsync();
        categories = categoriesData ?? new List<Category>();
    }

    private async Task LoadProductAsync(int id)
    {
        var productDto = await ProductApi.GetProductByIdAsync(id);
        if (productDto != null)
        {
            product = new ProductFormModel
            {
                Name = productDto.Name,
                SKU = productDto.SKU,
                Description = productDto.Description,
                Price = productDto.Price,
                StockQuantity = productDto.StockQuantity,
                CategoryId = productDto.CategoryId,
                IsActive = productDto.IsActive
            };
            
            imagesText = string.Join(Environment.NewLine, productDto.Images);
        }
        else
        {
            errorMessage = "Product not found.";
        }
    }

    private List<string> ParseImages()
    {
        if (string.IsNullOrWhiteSpace(imagesText))
            return new List<string>();

        return imagesText.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim())
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .ToList();
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        errorMessage = string.Empty;

        try
        {
            var images = ParseImages();

            if (isEditMode && Id.HasValue)
            {
                var updateDto = new UpdateProductDto
                {
                    Name = product.Name,
                    SKU = product.SKU,
                    Description = product.Description,
                    Price = product.Price,
                    StockQuantity = product.StockQuantity,
                    CategoryId = product.CategoryId,
                    IsActive = product.IsActive,
                    Images = images
                };

                var success = await ProductApi.UpdateProductAsync(Id.Value, updateDto);
                if (success)
                {
                    Navigation.NavigateTo("/admin/products");
                }
                else
                {
                    errorMessage = "Failed to update product. Please try again.";
                }
            }
            else
            {
                var createDto = new CreateProductDto
                {
                    Name = product.Name,
                    SKU = product.SKU,
                    Description = product.Description,
                    Price = product.Price,
                    StockQuantity = product.StockQuantity,
                    CategoryId = product.CategoryId,
                    IsActive = product.IsActive,
                    Images = images
                };

                var result = await ProductApi.CreateProductAsync(createDto);
                if (result != null)
                {
                    Navigation.NavigateTo("/admin/products");
                }
                else
                {
                    errorMessage = "Failed to create product. Please try again.";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving product: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private class ProductFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string SKU { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public int StockQuantity { get; set; }
        public int? CategoryId { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
