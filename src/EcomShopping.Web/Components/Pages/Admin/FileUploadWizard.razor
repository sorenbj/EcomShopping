@using EcomShopping.Application.DTOs
@using Microsoft.AspNetCore.Components.Forms
@inject FileImportApiService ImportApi
@inject IJSRuntime JSRuntime

<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    @if (currentStep == 1)
                    {
                        <text>Step 1: Select File</text>
                    }
                    else if (currentStep == 2)
                    {
                        <text>Step 2: Preview Data</text>
                    }
                </h5>
                <button type="button" class="btn-close" @onclick="OnClose"></button>
            </div>
            <div class="modal-body">
                @if (currentStep == 1)
                {
                    <div class="mb-3">
                        <label class="form-label">Select Target Table</label>
                        <select class="form-select" @bind="selectedTable">
                            <option value="">-- Select Table --</option>
                            @foreach (var table in availableTables)
                            {
                                <option value="@table.TableName">@table.TableName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Upload File</label>
                        <InputFile OnChange="HandleFileSelected" class="form-control" accept=".xlsx,.json,.xml" />
                        <small class="form-text text-muted">
                            Supported formats: Excel (.xlsx), JSON (.json), XML (.xml)
                        </small>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }

                    @if (selectedFile != null)
                    {
                        <div class="alert alert-info">
                            <strong>Selected file:</strong> @selectedFile.Name (@((selectedFile.Size / 1024.0).ToString("F2")) KB)
                        </div>
                    }
                }
                else if (currentStep == 2 && uploadResult != null)
                {
                    <div class="alert alert-success">
                        <strong>File uploaded successfully!</strong><br/>
                        Total records: @uploadResult.TotalRecords
                    </div>

                    <h6>Available Fields:</h6>
                    <div class="mb-3">
                        @foreach (var field in uploadResult.AvailableFields)
                        {
                            <span class="badge bg-secondary me-1 mb-1">@field</span>
                        }
                    </div>

                    <h6>Data Preview (first 5 records):</h6>
                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-sm table-bordered">
                            <thead class="table-light">
                                <tr>
                                    @foreach (var field in uploadResult.AvailableFields)
                                    {
                                        <th>@field</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in uploadResult.PreviewRecords)
                                {
                                    <tr>
                                        @foreach (var field in uploadResult.AvailableFields)
                                        {
                                            <td>
                                                @if (record.ContainsKey(field))
                                                {
                                                    @record[field]
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="modal-footer">
                @if (currentStep == 1)
                {
                    <button type="button" class="btn btn-secondary" @onclick="OnClose">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="UploadFile" disabled="@(selectedFile == null || string.IsNullOrEmpty(selectedTable) || isUploading)">
                        @if (isUploading)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <text>Uploading...</text>
                        }
                        else
                        {
                            <i class="bi bi-upload"></i>
                            <text> Upload & Preview</text>
                        }
                    </button>
                }
                else if (currentStep == 2)
                {
                    <button type="button" class="btn btn-secondary" @onclick="GoBack">Back</button>
                    <button type="button" class="btn btn-success" @onclick="CompleteImport">
                        <i class="bi bi-check-circle"></i> Complete Import
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<int> OnImportComplete { get; set; }

    private int currentStep = 1;
    private IBrowserFile? selectedFile;
    private string selectedTable = string.Empty;
    private string errorMessage = string.Empty;
    private bool isUploading = false;
    private List<ImportTableInfoDto> availableTables = new();
    private FileUploadResultDto? uploadResult;

    protected override async Task OnInitializedAsync()
    {
        await LoadAvailableTablesAsync();
    }

    private async Task LoadAvailableTablesAsync()
    {
        var tables = await ImportApi.GetAvailableTablesAsync();
        availableTables = tables ?? new List<ImportTableInfoDto>();
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        errorMessage = string.Empty;
    }

    private async Task UploadFile()
    {
        if (selectedFile == null || string.IsNullOrEmpty(selectedTable))
        {
            errorMessage = "Please select a file and target table";
            return;
        }

        try
        {
            isUploading = true;
            errorMessage = string.Empty;
            StateHasChanged();

            using var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB max
            uploadResult = await ImportApi.UploadFileAsync(stream, selectedFile.Name, selectedTable, "Admin");

            if (uploadResult != null)
            {
                currentStep = 2;
            }
            else
            {
                errorMessage = "Failed to upload file. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error uploading file: {ex.Message}";
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        currentStep = 1;
        uploadResult = null;
    }

    private async Task CompleteImport()
    {
        if (uploadResult != null && selectedFile != null)
        {
            try
            {
                isUploading = true;
                errorMessage = string.Empty;
                StateHasChanged();

                // Re-open the file and execute import
                using var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                var result = await ImportApi.UploadAndImportFileAsync(
                    stream, 
                    selectedFile.Name, 
                    selectedTable, 
                    "Admin");

                if (result != null)
                {
                    if (result.SuccessfulRecords > 0)
                    {
                        await OnImportComplete.InvokeAsync(result.JobId);
                    }
                    else
                    {
                        errorMessage = $"Import failed. {string.Join(", ", result.Errors.Take(3))}";
                        StateHasChanged();
                    }
                }
                else
                {
                    errorMessage = "Failed to import data. Please try again.";
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error importing data: {ex.Message}";
                StateHasChanged();
            }
            finally
            {
                isUploading = false;
            }
        }
    }
}
