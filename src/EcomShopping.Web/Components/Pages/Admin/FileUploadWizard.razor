@using EcomShopping.Application.DTOs
@using Microsoft.AspNetCore.Components.Forms
@inject FileImportApiService ImportApi
@inject IJSRuntime JSRuntime

<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    @if (currentStep == 1)
                    {
                        <text>Import File</text>
                    }
                    else if (currentStep == 2)
                    {
                        <text>Import Results</text>
                    }
                </h5>
                <button type="button" class="btn-close" @onclick="OnClose"></button>
            </div>
            <div class="modal-body">
                @if (currentStep == 1)
                {
                    <div class="mb-3">
                        <label class="form-label">Select Target Table</label>
                        <select class="form-select" @bind="selectedTable">
                            <option value="">-- Select Table --</option>
                            @foreach (var table in availableTables)
                            {
                                <option value="@table.TableName">@table.TableName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Upload File</label>
                        <InputFile OnChange="HandleFileSelected" class="form-control" accept=".xlsx,.json,.xml" />
                        <small class="form-text text-muted">
                            Supported formats: Excel (.xlsx), JSON (.json), XML (.xml)
                        </small>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }

                    @if (selectedFile != null)
                    {
                        <div class="alert alert-info">
                            <strong>Selected file:</strong> @selectedFile.Name (@((selectedFile.Size / 1024.0).ToString("F2")) KB)
                        </div>
                    }
                }
                else if (currentStep == 2 && importResult != null)
                {
                    @if (importResult.SuccessfulRecords > 0)
                    {
                        <div class="alert alert-success">
                            <h6 class="alert-heading"><i class="bi bi-check-circle"></i> Import Completed Successfully!</h6>
                            <hr/>
                            <p class="mb-0">
                                <strong>File:</strong> @importResult.FileName<br/>
                                <strong>Total Records:</strong> @importResult.TotalRecords<br/>
                                <strong>Successful:</strong> @importResult.SuccessfulRecords<br/>
                                <strong>Failed:</strong> @importResult.FailedRecords<br/>
                                <strong>Duration:</strong> @importResult.DurationSeconds.ToString("F2") seconds
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Import Completed with Errors</h6>
                            <hr/>
                            <p>
                                <strong>File:</strong> @importResult.FileName<br/>
                                <strong>Total Records:</strong> @importResult.TotalRecords<br/>
                                <strong>Successful:</strong> @importResult.SuccessfulRecords<br/>
                                <strong>Failed:</strong> @importResult.FailedRecords
                            </p>
                        </div>
                    }

                    @if (importResult.Errors.Any())
                    {
                        <h6>Errors:</h6>
                        <div class="alert alert-danger" style="max-height: 300px; overflow-y: auto;">
                            <ul class="mb-0">
                                @foreach (var error in importResult.Errors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }
                }
            </div>
            <div class="modal-footer">
                @if (currentStep == 1)
                {
                    <button type="button" class="btn btn-secondary" @onclick="OnClose">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="UploadAndImportFile" disabled="@(selectedFile == null || string.IsNullOrEmpty(selectedTable) || isUploading)">
                        @if (isUploading)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <text>Importing...</text>
                        }
                        else
                        {
                            <i class="bi bi-upload"></i>
                            <text> Import File</text>
                        }
                    </button>
                }
                else if (currentStep == 2)
                {
                    <button type="button" class="btn btn-primary" @onclick="CompleteImport">
                        <i class="bi bi-check-circle"></i> Done
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<int> OnImportComplete { get; set; }

    private int currentStep = 1;
    private IBrowserFile? selectedFile;
    private string selectedTable = string.Empty;
    private string errorMessage = string.Empty;
    private bool isUploading = false;
    private List<ImportTableInfoDto> availableTables = new();
    private EcomShopping.Web.Services.ImportResultDto? importResult;

    protected override async Task OnInitializedAsync()
    {
        await LoadAvailableTablesAsync();
    }

    private async Task LoadAvailableTablesAsync()
    {
        var tables = await ImportApi.GetAvailableTablesAsync();
        availableTables = tables ?? new List<ImportTableInfoDto>();
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        errorMessage = string.Empty;
    }

    private async Task UploadAndImportFile()
    {
        if (selectedFile == null || string.IsNullOrEmpty(selectedTable))
        {
            errorMessage = "Please select a file and target table";
            return;
        }

        try
        {
            isUploading = true;
            errorMessage = string.Empty;
            StateHasChanged();

            using var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB max
            importResult = await ImportApi.UploadAndImportFileAsync(
                stream, 
                selectedFile.Name, 
                selectedTable, 
                "Admin");

            if (importResult != null)
            {
                currentStep = 2;
            }
            else
            {
                errorMessage = "Failed to upload and import file. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error uploading and importing file: {ex.Message}";
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        currentStep = 1;
        importResult = null;
    }

    private async Task CompleteImport()
    {
        if (importResult != null)
        {
            await OnImportComplete.InvokeAsync(importResult.JobId);
        }
    }
}
